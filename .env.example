# Neon pooled connection string
DATABASE_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Single admin identity (no sign-up route exists).
# In .env files every "$" of the bcrypt hash must be written as "\$", because
# Next.js expands unescaped "$..." as a variable reference and silently
# truncates the hash. In a platform env UI (Vercel) paste the raw hash instead.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Base32 TOTP secret. When set, login also requires a 6-digit authenticator
# code; remove the line to turn 2FA off (this is also the lockout escape hatch).
ADMIN_TOTP_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Contact form email delivery via Gmail SMTP. Messages are always saved to the
# database; these only control the notification email, skipped when unset.
# GMAIL_APP_PASSWORD is a 16-character App Password (requires 2-Step
# Verification): https://myaccount.google.com/apppasswords
GMAIL_USER=ismaillyamani4@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=ismaillyamani4@gmail.com

# Public site URL, used for canonical links, hreflang, OG tags and the sitemap.
# Local: http://localhost:3000 — Production: https://ismail-lyamani.com
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (contact form CAPTCHA). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile
# Locally, leaving these unset skips the CAPTCHA. On Vercel a missing secret
# makes the contact form reject every submission, so set both there.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron authenticates to /api/cron/purge with this bearer token. Set it
# only in Vercel; the route rejects every request when it is unset.
CRON_SECRET=
